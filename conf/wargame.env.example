# WARGAME Production Environment Configuration
# File location on production VM: /etc/wargame/wargame.env
# Permissions: chmod 600 /etc/wargame/wargame.env (owned by root:root)
#
# CRITICAL DEPLOYMENT REQUIREMENTS:
# /etc/wargame/wargame.env is the unified EnvironmentFile loaded by:
#   - wargame-ssh.service (AsyncSSH WOPR terminal on TCP port 22)
#   - wargame-ftp.service (pyftpdlib Datanet archive on TCP port 21)
#   - wargame-http.service (FastAPI web portal on TCP port 80)
#
# BOTH FLAG and WOPR_PASSWORD MUST be defined in this file.
# Never overwrite the entire file when changing one variable.

# Server-side CTF flag.
# Never commit the real production flag.
FLAG=THM{REPLACE_WITH_DEPLOYMENT_SECRET}

# WOPR player authentication password.
# Discovered in-game through the Datanet archive.
# Never commit the real password.
WOPR_PASSWORD=REPLACE_WITH_WOPR_PASSWORD

# Production database path
DB_PATH=/opt/wargame/state/wargame.db

# Host key path for WOPR AsyncSSH server
SSH_HOST_KEY=/etc/wargame/ssh_host_key

# Terminal typing delay (0 for instant, or 0.01 for retro CRT feel)
WOPR_TYPE_DELAY=0

# Python path for systemd services
PYTHONPATH=/opt/wargame