# WARGAME Production Environment Configuration
# File location on production VM: /etc/wargame/wargame.env
# Permissions: chmod 600 /etc/wargame/wargame.env (owned by root:root)
#
# The real flag is provisioned only on the deployment appliance.
# For the TryHackMe deployment, use the THM{...} flag format.
FLAG=THM{REPLACE_WITH_DEPLOYMENT_SECRET}

# WOPR player authentication password (provisioned on production VM; never committed to Git)
WOPR_PASSWORD=REPLACE_WITH_WOPR_PASSWORD

# Production database path
DB_PATH=/opt/wargame/state/wargame.db

# Terminal typing delay (0 for instant, or small value like 0.005 for authentic retro feel)
WOPR_TYPE_DELAY=0
